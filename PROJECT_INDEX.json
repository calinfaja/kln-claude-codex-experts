  "execution": {
    "single_expert": {
      "method": "Task tool (foreground)",
      "prompt_file": "/tmp/codex-{expert}-{TS}-prompt.txt",
      "command_pattern": "codex exec -m {model} --config model_reasoning_effort=\"{effort}\" --sandbox {mode} --full-auto --skip-git-repo-check \"$(cat /tmp/codex-{expert}-{TS}-prompt.txt)\" 2>/dev/null"
    },
    "parallel_multi_expert": {
      "method": "python3 subprocess.Popen (background Bash)",
      "prompt_files": "/tmp/codex-{role}-{TS}-prompt.txt",
      "output_files": "/tmp/codex-{role}-{TS}-output.txt",
      "typical_time": "5-6 min for 3 experts"
    },
    "parallel_autoresearch": {
      "method": "python3 subprocess.Popen (background Bash)",
      "prompt_files": "/tmp/codex-autoresearcher-{topic}-{TS}-prompt.txt",
      "output_files": "/tmp/codex-autoresearcher-{topic}-{TS}-output.txt",
      "sandbox": "read-only",
      "note": "Each topic runs independently; wall clock = slowest topic"
    },
    "job_tracking": {
      "registry": "/tmp/codex-experts-jobs.json",
      "fields": ["id", "expert", "pid", "started", "status", "output_file", "prompt_file"],
      "status_command": "codex status",
      "cancel_command": "codex cancel"
    }
  },
  "second_opinion_pairs": [
    {"primary": "architect", "counterbalance": "simplifier", "when": "Recommends new layers or abstractions"},
    {"primary": "simplifier", "counterbalance": "architect", "when": "Proposes removing structural elements"},
    {"primary": "implementer", "counterbalance": "code-reviewer", "when": "After implementation"},
    {"primary": "code-reviewer", "counterbalance": "security-analyst", "when": "Findings touch auth or data flow"},
    {"primary": "adversarial-reviewer", "counterbalance": "implementer", "when": "After identifying issues that need fixing"},
    {"primary": "scope-analyst", "counterbalance": "plan-reviewer", "when": "Scope is large or ambiguous"},
    {"primary": "security-analyst", "counterbalance": "implementer", "when": "Fixes need to be applied"},
    {"primary": "autoresearcher", "counterbalance": "architect", "when": "Research reveals structural patterns worth evaluating"}
  ],
  "configuration": {
    "codex_credentials": "~/.codex/config.toml",
    "bash_permissions": "~/.claude/settings.json",
    "required_permissions": ["Bash(codex:*)", "Bash(python3:*)"],
    "sessions": "~/.codex/sessions/"
  },
  "models": {
    "coding_default": "gpt-5.3-codex",
    "analysis_default": "gpt-5.4",
    "available": ["gpt-5.4", "gpt-5.4-mini", "gpt-5.4-nano", "gpt-5.3-codex", "gpt-5.3-codex-spark"],
    "context_window": "1M tokens (gpt-5.4), 400k tokens (gpt-5.3-codex)"
  },
  "dependencies": ["codex CLI", "python3", "bash"]
